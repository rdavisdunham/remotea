{
  "appId": "com.remotea.app",
  "productName": "remotea",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "rdavisdunham",
    "repo": "remotea"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "node_modules/**/*",
    "!**/*.ts",
    "!**/*.tsx",
    "!src/**/*",
    "!docs/**/*",
    "!tests/**/*"
  ],
  "asarUnpack": [
    "node_modules/node-pty/prebuilds/**"
  ],
  "afterPack": "build/after-pack.cjs",
  "mac": {
    "icon": "resources/icons/icon.png",
    "target": [
      { "target": "dir", "arch": ["arm64"] }
    ],
    "identity": "-",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "win": {
    "icon": "resources/icons/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "remotea",
    "artifactName": "remotea-${version}-setup.${ext}",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "remotea-${version}-portable.exe"
  },
  "extraResources": [
    { "from": "resources/icon.png", "to": "icon.png" },
    { "from": "resources/icons/icon.ico", "to": "icon.ico" },
    { "from": "resources/themes", "to": "themes" },
    { "from": "resources/sounds", "to": "sounds" },
    { "from": "resources/claude-instructions.md", "to": "claude-instructions/claude-instructions.md" },
    { "from": "src/shell-integration", "to": "shell-integration" },
    { "from": "dist/cli/remotea.js", "to": "cli/remotea.js" },
    { "from": "dist/cli/remotea-hook.js", "to": "cli/remotea-hook.js" },
    { "from": "dist/cli/remotea-codex.js", "to": "cli/remotea-codex.js" },
    { "from": "dist/cli/codex-relay.js", "to": "cli/codex-relay.js" },
    { "from": "dist/cli/codex-session-tracker.js", "to": "cli/codex-session-tracker.js" },
    { "from": "node_modules/ws", "to": "cli/node_modules/ws" },
    { "from": "dist/cli/transport-deadline.js", "to": "cli/transport-deadline.js" },
    { "from": "dist/cli/transport-retry.js", "to": "cli/transport-retry.js" },
    { "from": "dist/cli/wsl-network.js", "to": "cli/wsl-network.js" },
    { "from": "dist/cli/opencode-tui-install.js", "to": "cli/opencode-tui-install.js" },
    { "from": "dist/cli/forward.js", "to": "cli/forward.js" },
    { "from": "dist/cli/verbs.js", "to": "cli/verbs.js" },
    { "from": "src/cli-bin", "to": "cli-bin" },
    { "from": "src/cli-bin-ps", "to": "cli-bin-ps" },
    { "from": "src/codex-bin", "to": "codex-bin" },
    { "from": "src/codex-bin-ps", "to": "codex-bin-ps" },
    { "from": "resources/opencode-plugin", "to": "opencode-plugin" },
    { "from": "resources/agy-plugin", "to": "agy-plugin" },
    { "from": "resources/pi-extension", "to": "pi-extension" },
    { "from": "resources/omp-extension", "to": "omp-extension" }
  ]
}
