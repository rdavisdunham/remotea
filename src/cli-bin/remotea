#!/usr/bin/env bash
# remotea CLI shim. remotea prepends this dir (cli-bin) to PATH in every shell it
# spawns, so bare `remotea` resolves in non-interactive shells too (Claude Code's
# Bash tool, orchestrator hook scripts) — not just interactive panes. Runs the
# Node pipe client via the $REMOTEA_CLI path remotea injects; falls back to the copy
# next to this shim. There is no remotea.exe in this dir, so no PATHEXT collision.
CLI="${REMOTEA_CLI:-$(cd "$(dirname "$0")/../cli" && pwd)/remotea.js}"

# Prefer the runtime remotea resolved at launch (issue #187) — bare `node` assumes
# node is both installed and on PATH. Gated on the binary actually being
# executable from HERE, because $REMOTEA_NODE is a Win32 path and this script also
# runs under Git Bash; a path this shell cannot use falls back to the old
# behaviour rather than failing.
NODE=node
if [ -n "$REMOTEA_NODE" ] && [ -x "$REMOTEA_NODE" ]; then
  NODE="$REMOTEA_NODE"
  # remotea's own Electron binary is Node only with this set.
  [ -n "$REMOTEA_NODE_ELECTRON" ] && export ELECTRON_RUN_AS_NODE=1
fi

exec "$NODE" "$CLI" "$@"
