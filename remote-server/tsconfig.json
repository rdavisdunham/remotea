{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "../src/shared/remote-host-protocol.ts",
    "../src/shared/remote-hosts-types.ts",
    "../src/shared/eridani-link-protocol.ts",
    "../src/shared/agent-hook-rules.ts",
    "../src/shared/claude-notification.ts",
    "../src/main/remote-hosts/connection-fsm.ts",
    "../src/shared/remote-query-swallow.ts",
    "../src/main/startup-commands.ts",
    "../src/renderer/utils/mouse-modes.ts"
  ]
}
